# Django
SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_SETTINGS_MODULE=core.settings.dev

# Database
DB_NAME=orbit_db
DB_USER=orbit_user
DB_PASSWORD=orbit_pass
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=
DB_SSLMODE=
DB_CONN_MAX_AGE=60

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# Cloudinary (Day 22+; required for avatar, icon, and file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Backend host allowlist / frontend origins (needed in prod)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
RENDER_EXTERNAL_HOSTNAME=

# Frontend envs for Vercel
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000

# Production security (set to True when HTTPS is configured on your server)
# Set to False if nginx is handling plain HTTP or if you're behind a reverse proxy
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
